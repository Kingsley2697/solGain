# Server-only provider keys. Keep these out of NEXT_PUBLIC_ variables.
BIRDEYE_API_KEY=
HELIUS_API_KEY=
JUPITER_API_KEY=

# Supabase URL may be exposed to the browser. The secret key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate with: openssl rand -base64 48
WALLET_AUTH_SECRET=

# Canonical HTTPS deployment URL, e.g. https://app.example.com
NEXT_PUBLIC_SITE_URL=

# Persistent alerts and browser notifications. Generate a 32-byte key with:
# openssl rand -base64 32. VAPID public key is the only browser-visible value.
ALERT_ENCRYPTION_KEY=
ALERT_CRON_SECRET=
VAPID_SUBJECT=mailto:alerts@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional alert delivery channels.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
